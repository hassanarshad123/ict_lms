{
	"info": {
		"_postman_id": "lms-student-mobile-api",
		"name": "LMS Student Mobile App API",
		"description": "API collection for React Native student mobile app.\n\n## Authentication\nAll authenticated endpoints require the `Authorization` header:\n```\nAuthorization: token <api_key>:<api_secret>\n```\n\nGet your API credentials by calling the Login or Sign Up endpoint.\n\n## Base URL\nSet the `{{base_url}}` environment variable to your LMS instance URL (e.g., `https://your-lms.frappe.cloud`).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000",
			"type": "string"
		},
		{
			"key": "api_key",
			"value": "",
			"type": "string"
		},
		{
			"key": "api_secret",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Authentication",
			"description": "Login, signup, and user info endpoints",
			"item": [
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"usr\": \"student@example.com\",\n    \"pwd\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/method/lms.lms.api.api_login",
							"host": ["{{base_url}}"],
							"path": ["api", "method", "lms.lms.api.api_login"]
						},
						"description": "Login with email and password. Returns API credentials for authenticated requests.\n\n**Response:**\n```json\n{\n    \"message\": \"Login successful\",\n    \"api_key\": \"xxx\",\n    \"api_secret\": \"yyy\",\n    \"user\": {...}\n}\n```"
					}
				},
				{
					"name": "Sign Up",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"newstudent@example.com\",\n    \"full_name\": \"John Doe\",\n    \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/method/lms.lms.api.api_sign_up",
							"host": ["{{base_url}}"],
							"path": ["api", "method", "lms.lms.api.api_sign_up"]
						},
						"description": "Register a new student account. Returns API credentials immediately."
					}
				},
				{
					"name": "Get User Info",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "token {{api_key}}:{{api_secret}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/method/lms.lms.api.get_user_info",
							"host": ["{{base_url}}"],
							"path": ["api", "method", "lms.lms.api.get_user_info"]
						},
						"description": "Get current authenticated user's profile and roles."
					}
				}
			]
		},
